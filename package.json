{
  "name": "am-marketing-os",
  "private": true,
  "version": "1.0.0",
  "description": "A&M Marketing OS — internal marketing operating system for Meta performance marketing",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css,sql}\"",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.3",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "27.0.1",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.11"
  }
}
