# =============================================================================
# A&M Marketing OS — Environment Configuration
# =============================================================================
# Copy to `.env.local` (never commit real secrets).
# Every variable is parsed and validated by `@am/config`.
# With DEMO_MODE=true the whole product runs against deterministic fixture
# providers — no external credentials are required for development or demo
# acceptance.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — operative source of truth
# -----------------------------------------------------------------------------
# Public project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anon (publishable) key — safe for the browser, always paired with RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never expose to the browser, never prefix
# with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used by migrations and seeds.
DATABASE_URL=

# -----------------------------------------------------------------------------
# OpenAI — text, image and embedding capabilities
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Capability-based model configuration. The model names must never be hard
# coded in business logic — everything resolves through @am/ai providers.
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Optional override for self-hosted / proxied gateways.
OPENAI_BASE_URL=

# -----------------------------------------------------------------------------
# Meta (Facebook / Instagram) — Marketing API + Conversions API
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
# Shared token used to verify inbound webhook subscription handshakes.
META_VERIFY_TOKEN=
# Format: act_<numeric id>
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_ACTOR_ID=
META_PIXEL_ID=
META_DATASET_ID=
# Graph API version, e.g. v23.0 — pin explicitly, never float.
META_API_VERSION=v23.0

# -----------------------------------------------------------------------------
# HubSpot — CRM source of truth
# -----------------------------------------------------------------------------
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=
HUBSPOT_WEBHOOK_SECRET=
# Optional: private app token as an alternative to the OAuth flow.
HUBSPOT_PRIVATE_APP_TOKEN=

# -----------------------------------------------------------------------------
# Application secrets
# -----------------------------------------------------------------------------
# 32-byte key, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used for AES-256-GCM encryption of provider tokens and buffered PII.
APP_ENCRYPTION_KEY=
# HMAC secret for signed launch / attribution tokens (min. 32 chars).
TRACKING_SIGNING_SECRET=
# Bearer secret required by every /api/cron/* endpoint.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3000
NEXT_PUBLIC_FUNNEL_URL=http://localhost:3001
# Production defaults:
#   NEXT_PUBLIC_CONSOLE_URL=https://marketing.am-beratung.de
#   NEXT_PUBLIC_FUNNEL_URL=https://go.am-beratung.de

# -----------------------------------------------------------------------------
# Access control
# -----------------------------------------------------------------------------
# Comma separated allowlist of e-mail addresses and/or domains permitted to
# sign in to the console. Domains are written with a leading "@".
AUTH_ALLOWLIST=@am-beratung.de
# Comma separated allowlist of hosts that funnels may redirect to.
REDIRECT_ALLOWLIST=am-beratung.de,go.am-beratung.de,calendly.com

# -----------------------------------------------------------------------------
# Feature flags — safety rails
# -----------------------------------------------------------------------------
# DEMO_MODE routes every provider through deterministic fixtures.
DEMO_MODE=true
# Master kill switch. While false NO external write of any kind is performed.
EXTERNAL_WRITES_ENABLED=false
# Meta Marketing API mutations (create draft, pause, budget changes).
META_MUTATIONS_ENABLED=false
# Meta Conversions API dispatches.
META_CAPI_ENABLED=false
# HubSpot object writes (contacts, companies, deals, associations).
HUBSPOT_WRITES_ENABLED=false

# -----------------------------------------------------------------------------
# Operational tuning (safe defaults, override per environment)
# -----------------------------------------------------------------------------
# Attribution lookback window in days for the primary paid-Meta touch.
ATTRIBUTION_WINDOW_DAYS=30
# Inactivity window (minutes) after which a form instance is derived abandoned.
FORM_ABANDON_MINUTES=30
# Historical import range in months on first connect.
HISTORICAL_IMPORT_MONTHS=24
# Logical environment tag written onto every tracking event.
APP_ENVIRONMENT=development
